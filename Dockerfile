# syntax=docker/dockerfile:1
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN python - <<'PY'
import base64,io,tarfile
payload=""""""
with tarfile.open(fileobj=io.BytesIO(base64.b64decode(payload)),mode="r:gz") as tf:tf.extractall("/app")
PY
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN python -m py_compile /app/app.py && python - <<'PY'
from pathlib import Path
import re
s=Path("/app/app.py").read_text("utf-8");h=Path("/app/static/index.html").read_text("utf-8")
for x in ["1.3.6-MASTER-TRUTH-PERSIST","MASTER_READY_MIN","master_ready","master_source","rows_from","FALLBACK_15"]:
    assert x in s,x
for x in ["MASTER TRUTH + KRX/NXT SPLIT","MASTER FULL","MASTER FALLBACK","NOVA_OCC_V136_KRX","DB LOCAL + DEVICE"]:
    assert x in h,x
assert re.search(r"self\.states\b",s) is None
assert re.search(r"self\.discovery\b",s) is None
print("NOVA v1.3.6 MASTER TRUTH BUILD CHECK: PASS")
print("MORNING SCORE FORMULA SHA: cb07d19882f236bbd9e4bf37abac4951079c87de086a16df29caf08f0054101d")
PY
RUN useradd -m -u 10001 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 10000
CMD ["sh","-c","uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
