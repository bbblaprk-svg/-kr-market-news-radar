# syntax=docker/dockerfile:1
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN python - <<'PY'
import base64, io, tarfile
payload = """"""
data = base64.b64decode(payload)
with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as tf:
    tf.extractall("/app")
PY

RUN pip install --no-cache-dir -r /app/requirements.txt

RUN python -m py_compile /app/app.py && python - <<'PY'
from pathlib import Path
s=Path("/app/app.py").read_text("utf-8")
h=Path("/app/static/index.html").read_text("utf-8")
for x in [
    "1.2.0-MY-STOCK-DECISION","t1301","t9945","DecisionNameIn",
    "decision_by_name","decision_monitor_loop","MANUAL-ENTRY"
]:
    assert x in s,x
for x in [
    "③ MY STOCK DECISION","종목명만 입력","매수 타이밍 판정",
    "매수등록 → 매도관리","ENTRY SCORE","EXIT 위험"
]:
    assert x in h,x
print("NOVA v1.2.0 MY STOCK DECISION VERIFY: PASS")
PY

RUN useradd -m -u 10001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 10000
CMD ["sh","-c","uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
