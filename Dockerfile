# syntax=docker/dockerfile:1
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN printf '%s' '' > /tmp/nova_payload.b64
RUN printf '%s' '' >> /tmp/nova_payload.b64
RUN printf '%s' '' >> /tmp/nova_payload.b64
RUN printf '%s' '' >> /tmp/nova_payload.b64
RUN printf '%s' '' >> /tmp/nova_payload.b64
RUN printf '%s' '' >> /tmp/nova_payload.b64
RUN printf '%s' '' >> /tmp/nova_payload.b64
RUN printf '%s' '' >> /tmp/nova_payload.b64
RUN printf '%s' '' >> /tmp/nova_payload.b64
RUN printf '%s' '' >> /tmp/nova_payload.b64
RUN printf '%s' '' >> /tmp/nova_payload.b64
RUN printf '%s' '' >> /tmp/nova_payload.b64
RUN python -c "import base64,io,tarfile;p=open('/tmp/nova_payload.b64','r').read();t=tarfile.open(fileobj=io.BytesIO(base64.b64decode(p)),mode='r:gz');t.extractall('/app');t.close()"
RUN rm -f /tmp/nova_payload.b64
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN python -m py_compile /app/app.py
RUN python -c "from pathlib import Path;s=Path('/app/app.py').read_text('utf-8');h=Path('/app/static/index.html').read_text('utf-8');assert '1.4.1-TIGHT-SIGNAL-NXT-VERIFIED' in s;assert 'SIGNAL_DISPLAY_BUILDING_MIN = 68.0' in s;assert 'SIGNAL_DISPLAY_IGNITING_PRE_MIN = 60.0' in s;assert 'SIGNAL_DISPLAY_IGNITING_DELTA_MIN = 8.0' in s;assert 'NXT_TRACK_VALID_ONLY = True' in s;assert 'KRX ENERGY COMPOUNDING TOP10' in h;assert 'NXT ENERGY COMPOUNDING TOP10' in h;print('NOVA v1.4.1 CHUNKED BUILD CHECK PASS')"
RUN useradd -m -u 10001 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 10000
CMD ["sh","-c","uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
