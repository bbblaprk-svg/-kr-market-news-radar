# syntax=docker/dockerfile:1
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Self-contained build: this Dockerfile creates every runtime file itself.
# Existing repository source files are intentionally ignored.

RUN mkdir -p /app/static /app/data

RUN python - <<'PY'
import base64
from pathlib import Path
p = Path('/app/app.py')
p.parent.mkdir(parents=True, exist_ok=True)
p.write_bytes(base64.b64decode(''''''))
PY

RUN python - <<'PY'
import base64
from pathlib import Path
p = Path('/app/requirements.txt')
p.parent.mkdir(parents=True, exist_ok=True)
p.write_bytes(base64.b64decode('''ZmFzdGFwaT49MC4xMTUsPDEKdXZpY29ybltzdGFuZGFyZF0+PTAuMzAsPDEKaHR0cHg+PTAuMjcsPDEKd2Vic29ja2V0cz49MTMsPDE3ClNRTEFsY2hlbXk+PTIuMCw8Mwpwc3ljb3BnW2JpbmFyeV0+PTMuMiw8NAo='''))
PY

RUN python - <<'PY'
import base64
from pathlib import Path
p = Path('/app/static/index.html')
p.parent.mkdir(parents=True, exist_ok=True)
p.write_bytes(base64.b64decode(''''''))
PY

RUN python - <<'PY'
import base64
from pathlib import Path
p = Path('/app/static/login.html')
p.parent.mkdir(parents=True, exist_ok=True)
p.write_bytes(base64.b64decode(''''''))
PY

RUN python - <<'PY'
import base64
from pathlib import Path
p = Path('/app/data/watchlist.csv')
p.parent.mkdir(parents=True, exist_ok=True)
p.write_bytes(base64.b64decode(''''''))
PY

RUN pip install --no-cache-dir -r /app/requirements.txt

RUN python -m py_compile /app/app.py \
 && python - <<'PY'
from pathlib import Path
app = Path('/app/app.py').read_text('utf-8')
html = Path('/app/static/index.html').read_text('utf-8')
for x in [
    '1.0.1-EXISTING-REPO-REPLACE-LS-RENDER',
    'LS_APP_KEY',
    'LS_APP_SECRET',
    'APP_ACCESS_TOKEN',
    'APP_SESSION_SECRET',
    '@app.get("/healthz")',
    '@app.get("/health")',
    '"tr_cd": "t1101"',
    '"tr_cd": "NWS"',
]:
    assert x in app, x
for x in ['①','②','③','④','⑤','NOVA PRE-IGNITION']:
    assert x in html, x
print('NOVA PRE-IGNITION EMBEDDED BUILD VERIFY: PASS')
PY

RUN useradd -m -u 10001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 10000

CMD ["sh","-c","uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
