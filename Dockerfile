# syntax=docker/dockerfile:1
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN python - <<'PY'
import base64,io,tarfile
payload=""""""
with tarfile.open(fileobj=io.BytesIO(base64.b64decode(payload)),mode="r:gz") as tf:
    tf.extractall("/app")
PY
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN python -m py_compile /app/app.py && python - <<'PY'
from pathlib import Path
import re
s=Path("/app/app.py").read_text("utf-8"); h=Path("/app/static/index.html").read_text("utf-8")
for x in ["1.3.7-ACTIVE1000-5MIN","MIN_READY_MINUTES = 5.0",
          "ACTIVE_UNIVERSE_MAX = 1000","DELTA_LOOKBACK_SECONDS = 300",
          "BACKGROUND_BATCH_PER_PASS = 60",
          "(st.history[-1].ts-st.history[0].ts)>=MIN_READY_MINUTES*60"]:
    assert x in s,x
for x in ["ACTIVE1000 · 5MIN","5분+ · 5분 ΔPRE6+"]:
    assert x in h,x
assert re.search(r"self\.states\b",s) is None
assert re.search(r"self\.discovery\b",s) is None
print("NOVA v1.3.7 ACTIVE1000 + EXACT 5MIN BUILD CHECK: PASS")
print("APP SHA256: c7903142ee31070c4fb09b3b676a781524cea791cec984c890d9bdece0bbfec6")
PY
RUN useradd -m -u 10001 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 10000
CMD ["sh","-c","uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
