# syntax=docker/dockerfile:1
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN python - <<'PY2'
import base64,io,tarfile
payload=""""""
with tarfile.open(fileobj=io.BytesIO(base64.b64decode(payload)),mode="r:gz") as tf:
    tf.extractall("/app")
PY2
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN python -m py_compile /app/app.py && python - <<'PY2'
from pathlib import Path
s=Path("/app/app.py").read_text("utf-8")
h=Path("/app/static/index.html").read_text("utf-8")
for x in ["1.2.4-SIMPLE-SCOUT-NEWS10","scout_loop","LS_SCOUT","purge_old_signal_days","NEWS_DISPLAY_MAX = 10"]:
    assert x in s,x
for x in ["LS SIMPLE SCOUT · v1.2.4","DISCOVERY LS SCOUT","당일 유효신호 보존"]:
    assert x in h,x
print("NOVA v1.2.4 VERIFY: PASS")
PY2
RUN useradd -m -u 10001 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 10000
CMD ["sh","-c","uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
