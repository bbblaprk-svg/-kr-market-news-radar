# syntax=docker/dockerfile:1
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN python - <<'PY'
import base64,io,tarfile
payload=""""""
with tarfile.open(fileobj=io.BytesIO(base64.b64decode(payload)),mode="r:gz") as tf:tf.extractall("/app")
PY
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN python -m py_compile /app/app.py && python - <<'PY'
from pathlib import Path
s=Path('/app/app.py').read_text();h=Path('/app/static/index.html').read_text()
for x in ['1.3.2-MORNING-CORE-NXT-INTEGRATED','t8450','integrated_quote','occurrence_log','T8450_INTEGRATED','NXT_INTEGRATED_SCOUT']:assert x in s,x
for x in ['v1.3.2','MORNING CORE FROZEN','NXT t8450 INTEGRATED','ALERT ON']:assert x in h,x
print('NOVA v1.3.2 BUILD CHECK: PASS')
print('MORNING CORE HASH: 7ffea757e1ebb82b9a23adf38095aaab233452b63e8df9744f025ab970eadfaa')
PY
RUN useradd -m -u 10001 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 10000
CMD ["sh","-c","uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
