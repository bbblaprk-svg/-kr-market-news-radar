# syntax=docker/dockerfile:1
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN mkdir -p /app/static /app/data
RUN python - <<'PY'
import base64
from pathlib import Path
p=Path('/app/app.py')
p.parent.mkdir(parents=True,exist_ok=True)
p.write_bytes(base64.b64decode(''''''))
PY
RUN python - <<'PY'
import base64
from pathlib import Path
p=Path('/app/requirements.txt')
p.parent.mkdir(parents=True,exist_ok=True)
p.write_bytes(base64.b64decode('''ZmFzdGFwaT49MC4xMTUsPDEKdXZpY29ybltzdGFuZGFyZF0+PTAuMzAsPDEKaHR0cHg+PTAuMjcsPDEKd2Vic29ja2V0cz49MTMsPDE3ClNRTEFsY2hlbXk+PTIuMCw8Mwpwc3ljb3BnW2JpbmFyeV0+PTMuMiw8NAo='''))
PY
RUN python - <<'PY'
import base64
from pathlib import Path
p=Path('/app/static/index.html')
p.parent.mkdir(parents=True,exist_ok=True)
p.write_bytes(base64.b64decode(''''''))
PY
RUN python - <<'PY'
import base64
from pathlib import Path
p=Path('/app/static/login.html')
p.parent.mkdir(parents=True,exist_ok=True)
p.write_bytes(base64.b64decode(''''''))
PY
RUN python - <<'PY'
import base64
from pathlib import Path
p=Path('/app/data/watchlist.csv')
p.parent.mkdir(parents=True,exist_ok=True)
p.write_bytes(base64.b64decode(''''''))
PY
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN python -m py_compile /app/app.py && python - <<'PY'
from pathlib import Path
s=Path('/app/app.py').read_text('utf-8')
h=Path('/app/static/index.html').read_text('utf-8')
for x in ['1.1.0-PREIGNITION-WIDE-DISCOVERY','t1866','t1859','rank_snapshots','LS_CONDITION_INDEXES','IGNITING_DELTA_MIN','MIN_READY_MINUTES']:
    assert x in s,x
for x in ['①','②','③','④','⑤','10칸을 억지로 채우지 않습니다.','MARKET CLOSED']:
    assert x in h,x
print('NOVA v1.1 EMBEDDED VERIFY: PASS')
PY
RUN useradd -m -u 10001 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 10000
CMD ["sh","-c","uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
