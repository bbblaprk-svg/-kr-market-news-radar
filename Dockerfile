# syntax=docker/dockerfile:1
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN python - <<'PY'
import base64,io,tarfile
payload=""""""
with tarfile.open(fileobj=io.BytesIO(base64.b64decode(payload)),mode="r:gz") as tf:
    tf.extractall("/app")
PY
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN python -m py_compile /app/app.py && python - <<'PY'
from pathlib import Path
s=Path("/app/app.py").read_text("utf-8")
h=Path("/app/static/index.html").read_text("utf-8")
for x in [
 "1.3.0-ZEROLOCK-FIX","hotime_near_now","get_nxt_rank_candidate","quote_from_rank",
 "NXT_T1101_CURRENT","NXT_RANK","pipeline_stats","relative_building_ok",
 "squeeze_release_metrics","flow_persistence_metrics","relative_acceleration_metrics"
]:
    assert x in s,x
for x in ["v1.3.0","실제갱신","5분이력","0종목 잠금 제거","ALERT ON"]:
    assert x in h,x
print("NOVA v1.3.0 ZERO-LOCK FIX BUILD CHECK: PASS")
PY
RUN useradd -m -u 10001 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 10000
CMD ["sh","-c","uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
