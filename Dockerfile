RUN base64 -d /tmp/pulse_release.b64 > /tmp/pulse_release.tar.gz \
    && tar -xzf /tmp/pulse_release.tar.gz -C /app \
    && rm -f /tmp/pulse_release.b64 /tmp/pulse_release.tar.gz \
    && chmod +x /app/start-onebox.sh \
    && mkdir -p /data
RUN cd /app/ls_bridge && npm ci --omit=dev --no-audit --no-fund && npm test
RUN cd /app/pulse_core && python3 -m unittest discover -s tests -q
ENV NODE_ENV=production \
    LS_OPENAPI_ENABLED=true \
    LS_BASE_URL=https://openapi.ls-sec.co.kr:8080 \
    LS_REALTIME_WS_URL=wss://openapi.ls-sec.co.kr:9443/websocket \
    PULSE_DEEP_TARGET_MAX=30 \
    LS_REALTIME_TARGET_MAX=30 \
    PULSE_FRAME_MAX_SPAN_MS=85000 \
    V127_POLL_SECONDS=60
EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 CMD curl -fsS http://127.0.0.1:${PORT:-10000}/health >/dev/null || exit 1
CMD ["/app/start-onebox.sh"]
