PULSE_V1273_PAYLOAD
RUN set -eux; \
    base64 -d /tmp/pulse_runtime.tar.gz.b64 > /tmp/pulse_runtime.tar.gz; \
    echo "9e4cc6ad918a289546fb96007cee707bb12ebf93797bcc73b0c4f09771cbef71  /tmp/pulse_runtime.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/pulse_runtime.tar.gz -C /app; \
    rm -f /tmp/pulse_runtime.tar.gz /tmp/pulse_runtime.tar.gz.b64; \
    cd /app/pulse_bridge; npm install --omit=dev --no-audit --no-fund; node tests.js; \
    cd /app/pulse_core; python3 -m unittest discover -s tests -q; \
    sha256sum /app/ls_provider_original/lib/lsOpenApi.js | grep -q '^ac44a47196bf00bc8dc878bc39f514265614db6c76b6c0761f03940a7b7c43f8 '; \
    sha256sum /app/ls_provider_original/lib/realtimeFeed.js | grep -q '^17ad7201ed3ad1273d32d8dbab619d473a90c45a634e8d7d13257ac620105013 '
EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD curl -fsS "http://127.0.0.1:${PORT:-10000}/health" >/dev/null || exit 1
CMD ["/app/start-onebox.sh"]
