# syntax=docker/dockerfile:1.7
FROM node:20-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    APP_VERSION=PULSE_EDGE_V12_7_3_EARLY_ROTATION_FIRST \
    LS_OPENAPI_ENABLED=true \
    LS_BASE_URL=https://openapi.ls-sec.co.kr:8080 \
    LS_REALTIME_WS_URL=wss://openapi.ls-sec.co.kr:9443/websocket \
    PULSE_DEEP_TARGET_MAX=30 \
    LS_FEED_STALE_MS=20000 \
    LS_REALTIME_RETAIN_MS=720000
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates curl && rm -rf /var/lib/apt/lists/*
